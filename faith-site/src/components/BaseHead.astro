---
import { SITE } from '../data/site';
import AdSenseHead from './AdSenseHead.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  preloadHero?: boolean;
  noindex?: boolean;
  articleSection?: string;
  articleTags?: string[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  preloadHero = false,
  noindex = false,
  articleSection,
  articleTags,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site || SITE.url).toString();
const ogImageUrl = new URL('/images/og-default.png', Astro.site || SITE.url).toString();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? (
  <meta name="robots" content="noindex, follow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}
{!noindex && <link rel="canonical" href={canonicalUrl} />}
{!noindex && <link rel="alternate" hreflang="en" href={canonicalUrl} />}
{!noindex && SITE.targetRegions.map((region) => (
  <link rel="alternate" hreflang={`en-${region}`} href={canonicalUrl} />
))}
{!noindex && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}
<meta name="author" content={SITE.teacher.name} />
<meta name="theme-color" content="#0D1117" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#FAF7F0" media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="LIJN" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="format-detection" content="telephone=no" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} — RSS Feed`}
  href="/rss.xml"
/>

<!-- Preload the two variable font families only (DESIGN_SPEC §10) -->
<link
  rel="preload"
  href="/fonts/fraunces-latin-opsz-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/inter-latin-wght-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

{
  preloadHero && (
    <link
      rel="preload"
      as="image"
      href="/images/hero-dawn-1600.avif"
      type="image/avif"
      imagesrcset="/images/hero-dawn-960.avif 960w, /images/hero-dawn-1600.avif 1600w"
      imagesizes="100vw"
    />
  )
}

<!-- Open Graph / Social -->
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
{SITE.ogAlternateLocales.map((loc) => <meta property="og:locale:alternate" content={loc} />)}
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name} — ${title}`} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{articleSection && <meta property="article:section" content={articleSection} />}
{articleTags && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
{publishedTime && <meta property="article:author" content={SITE.teacher.name} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={`${SITE.name} — ${title}`} />

<!--
  AI discovery.

  There is no single tag a language model looks for, so this emits the three
  signals that actually get read: the llms.txt convention, the corpus and JSON
  endpoints, and an explicit content-usage policy. The usage policy is the
  machine-readable half of the licence statement in llms.txt: quote and summarise
  freely, do not use the corpus to train a competing publication.
-->
<link rel="llms" type="text/plain" href="/llms.txt" title={`${SITE.name} — AI index`} />
<link rel="alternate" type="application/json" href="/api/articles.json" title={`${SITE.name} — article data`} />
<meta name="ai-content-policy" content="index, cite, quote, summarise; attribution and link required; no bulk republication" />
<meta name="ai-training" content="allowed-with-attribution" />
<meta name="citation-title" content={title} />
<meta name="citation-author" content={SITE.teacher.name} />

<!-- Zero-FOUC Theme & Reading-Comfort Initialization -->
<script is:inline>
  (function () {
    try {
      var saved = localStorage.getItem('ijn-theme');
      var prefersDark =
        window.matchMedia &&
        window.matchMedia('(prefers-color-scheme: dark)').matches;
      var theme = saved === 'dark' || saved === 'light' ? saved : prefersDark ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', theme);
      var scale = localStorage.getItem('ijn-scale');
      if (scale && ['0.92', '1', '1.12', '1.24'].indexOf(scale) !== -1) {
        document.documentElement.style.setProperty('--reading-scale', scale);
      }
      document.documentElement.classList.add('js-ready');
    } catch (e) {}
  })();
</script>

<AdSenseHead />
