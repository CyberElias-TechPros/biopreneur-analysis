---
/**
 * Floating WhatsApp desk button — present on every page.
 *
 * Two deliberate constraints, both from DESIGN_SPEC §9:
 *   · §9.6 "zero interruption reading" — the button must never cover prose.
 *     It is a small pill anchored bottom-right on desktop, and on narrow
 *     screens it shrinks to a 52px circle, which clears a 320px text column.
 *   · §9.5 the primary nav stays at five items — this is a utility affordance,
 *     not a navigation entry, so it does not count against that cap.
 *
 * The label collapses on scroll and on small screens; the accessible name is
 * carried by aria-label in every state, so the control is never ambiguous to a
 * screen reader or to a reader who only sees the circle.
 */
import { SITE } from '../data/site';

const href = `https://wa.me/${SITE.whatsapp.e164}?text=${encodeURIComponent(
  'Hello, I am writing from the Live In Jesus Name website.'
)}`;
---

<a
  class="wa-float"
  id="wa-float"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={`Message the teaching desk on WhatsApp at ${SITE.whatsapp.display}`}
  data-wa-float
>
  <span class="wa-float__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true" focusable="false">
      <path
        d="M12 2.6a9.3 9.3 0 0 0-7.9 14.2L2.7 21.3l4.6-1.3A9.3 9.3 0 1 0 12 2.6Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <path
        d="M8.7 8.1c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .6.4l.8 1.8c.1.3 0 .5-.1.7l-.5.6c-.2.2-.2.4-.1.6.5.9 1.3 1.7 2.2 2.2.2.1.4.1.6-.1l.6-.6c.2-.2.4-.2.7-.1l1.8.8c.3.1.4.3.4.5v.5c0 .8-.6 1.5-1.4 1.6-.6.1-1.4 0-2.6-.5a10 10 0 0 1-4.7-4.3c-.4-.7-.6-1.3-.6-1.9 0-.7.2-1.2.5-1.6Z"
        fill="currentColor"
      />
    </svg>
  </span>
  <span class="wa-float__text">
    <span class="wa-float__label">WhatsApp</span>
    <span class="wa-float__number">{SITE.whatsapp.display}</span>
  </span>
</a>
