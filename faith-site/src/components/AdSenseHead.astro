---
import { SITE } from '../data/site';

/*
  Google AdSense identity + consent-gated loader.

  Two things must be true at once for a publisher site:
    · Google must be able to verify ownership and serve Auto ads.
    · EU/UK/EEA readers must give consent before advertising cookies are set.

  So the account meta tag (a passive ownership signal, no cookies) is always
  emitted, while the ad *script* — which is what actually sets advertising
  cookies — is injected by `consent.ts` only after a reader chooses "Accept all".
  A reader who chooses "Essential only" is never tracked and sees no ads; the
  teaching is unaffected.
*/
---
<meta name="google-adsense-account" content={SITE.adsense.publisherId} />
<meta name="ijn-adsense-client" content={SITE.adsense.publisherId} />
