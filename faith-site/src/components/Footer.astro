---
import { SITE } from '../data/site';
import LightLine from './LightLine.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <LightLine />
  <div class="swiss-container footer-inner">
    <div class="footer-grid">
      <div>
        <p
          style="font-family: var(--font-display); font-size: 1.5rem; margin: 0 0 0.65rem 0; color: #FAF7F0;"
        >
          {SITE.name}
        </p>
        <p style="margin: 0 0 1rem 0; color: #C5CBD3; max-width: 44ch; font-size: 0.96rem;">
          {SITE.mission}
        </p>
        <p class="meta-caps" style="color: #D4AF6A; margin: 0;">
          “The entrance of thy words giveth light; it giveth understanding unto the simple.” — Psalm 119:130
        </p>
      </div>

      <div>
        <p class="meta-caps" style="color: #9AA3AE; margin: 0;">Teaching Room</p>
        <ul class="footer-list">
          {
            SITE.footerLinks.study.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="meta-caps" style="color: #9AA3AE; margin: 0;">Reader Community</p>
        <ul class="footer-list">
          {
            SITE.footerLinks.community.map((link) => {
              const isExternal = link.href.startsWith('http');
              return (
                <li>
                  <a
                    href={link.href}
                    {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
        <p class="meta-caps" style="color: #9AA3AE; margin: 0.9rem 0 0 0;">Teaching Desk</p>
        <p style="margin: 0.3rem 0 0 0; font-size: 0.92rem; color: #C5CBD3;">
          <a
            href={`https://wa.me/${SITE.whatsapp.e164}`}
            target="_blank"
            rel="noopener"
            aria-label={`Message the teaching desk on WhatsApp at ${SITE.whatsapp.display}`}
          >
            {SITE.whatsapp.display}
          </a>
        </p>
      </div>

      <div>
        <p class="meta-caps" style="color: #9AA3AE; margin: 0;">Foundations &amp; Policy</p>
        <ul class="footer-list">
          {
            SITE.footerLinks.trust.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>
        &copy; {year} {SITE.name}. All teachings are original Scripture-anchored works.
      </span>
      <span>
        Faith &amp; sound wisdom walk together &middot;{' '}
        <a href="/privacy/">Privacy</a> &middot;{' '}
        <a href="/doctrinal-basis/">Doctrinal Basis</a> &middot;{' '}
        <a href="/contact/">Contact</a> &middot;{' '}
        <a href="/community/">Community</a>
      </span>
    </div>
  </div>
</footer>
