---
import { SITE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer sc-footer" role="contentinfo">
  <div class="sc-footer__glow" aria-hidden="true"></div>

  <div class="swiss-container sc-footer__inner">
    <!-- Cinematic sign-off: the verse, then the name as a horizon of type. -->
    <div class="sc-footer__statement">
      <p class="sc-footer__verse">
        “The entrance of thy words giveth light; it giveth understanding unto the simple.”
        <span class="sc-footer__ref">— Psalm 119:130</span>
      </p>
      <p class="sc-footer__wordmark" aria-hidden="true">{SITE.name}</p>
      <p class="visually-hidden">{SITE.name}</p>
    </div>

    <hr class="sc-rule" />

    <div class="footer-grid sc-footer__grid">
      <div>
        <p class="sc-footer__brand">{SITE.name}</p>
        <p class="sc-footer__mission">{SITE.mission}</p>
      </div>

      <div>
        <p class="meta-caps sc-footer__label">Teaching Room</p>
        <ul class="footer-list">
          {SITE.footerLinks.study.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="meta-caps sc-footer__label">Reader Community</p>
        <ul class="footer-list">
          {SITE.footerLinks.community.map((link) => {
            const isExternal = link.href.startsWith('http');
            return (
              <li>
                <a href={link.href} {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}>
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
        <p class="meta-caps sc-footer__label sc-footer__label--gap">Teaching Desk</p>
        <p class="sc-footer__desk">
          <a
            href={`https://wa.me/${SITE.whatsapp.e164}`}
            target="_blank"
            rel="noopener"
            aria-label={`Message the teaching desk on WhatsApp at ${SITE.whatsapp.display}`}
          >
            {SITE.whatsapp.display}
          </a>
        </p>
      </div>

      <div>
        <p class="meta-caps sc-footer__label">Foundations &amp; Policy</p>
        <ul class="footer-list">
          {SITE.footerLinks.trust.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom sc-footer__bottom">
      <span>
        &copy; {year} {SITE.name}. All teachings are original Scripture-anchored works.
      </span>
      <span>
        Faith &amp; sound wisdom walk together &middot;{' '}
        <a href="/privacy/">Privacy</a> &middot;{' '}
        <a href="/doctrinal-basis/">Doctrinal Basis</a> &middot;{' '}
        <a href="/contact/">Contact</a> &middot;{' '}
        <button type="button" class="footer-consent" data-open-consent>
          Cookie settings
        </button>
      </span>
    </div>
  </div>
</footer>
