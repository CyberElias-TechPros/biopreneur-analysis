---
/**
 * The Listening Room — shown once per teaching, directly under the meta line.
 *
 * Everything visual here is static HTML so the control is keyboard-reachable and
 * styled before any JS runs; the script only wires behaviour. That ordering is
 * deliberate: an article must never depend on JS to be readable, and it must not
 * shift when the listener boots.
 */
import { SITE } from '../data/site';
import { LISTEN_LANGUAGES } from '../data/languages';

interface Props {
  title: string;
  url: string;
  /** Optional slug of the source article, used for analytics-free deep links. */
  slug?: string;
}
const { title, url, slug } = Astro.props;

const config = {
  lang: LISTEN_LANGUAGES[0].code,
  languages: LISTEN_LANGUAGES.map((l) => ({
    code: l.code,
    label: l.label,
    english: l.english,
    speech: l.speech,
    translate: l.translate,
    dir: l.dir ?? 'ltr',
  })),
  voices: SITE.listen.voices,
  rates: SITE.listen.rates,
  articleTitle: title,
  articleUrl: url,
  libraryUrl: '/listen/',
};
---

<section
  class="listen-room"
  id="listen-room"
  aria-labelledby="listen-room-heading"
  data-listen-slug={slug}
>
  <script
    is:inline
    type="application/json"
    id="listen-room-config"
    set:html={JSON.stringify(config)}
  />

  <h2 class="visually-hidden" id="listen-room-heading">Listen to this teaching</h2>

  <div class="listen-bar">
    <button
      type="button"
      class="listen-toggle"
      id="listen-toggle"
      aria-expanded="false"
      aria-controls="listen-panel"
    >
      <span class="listen-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" focusable="false">
          <path d="M4 10v4h3l4 3V7l-4 3H4Z" fill="currentColor" />
          <path d="M15 9.5a4 4 0 0 1 0 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M17.5 7a7.5 7.5 0 0 1 0 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </span>
      <span>Listen to this teaching</span>
    </button>

    <div class="listen-quick">
      <label class="visually-hidden" for="listen-language">Reading language</label>
      <select id="listen-language" class="listen-select">
        {
          LISTEN_LANGUAGES.map((l) => (
            <option value={l.code} data-external={l.translate === 'external' ? 'true' : undefined}>
              {l.label}
              {l.translate === 'external' ? ' ↗' : ''}
            </option>
          ))
        }
      </select>
      <span class="listen-badge" title="Speech is generated by your own device">
        On-device voice
      </span>
    </div>
  </div>

  <div class="listen-panel" id="listen-panel" hidden>
    <div class="listen-panel__grid">
      <fieldset class="listen-fieldset">
        <legend class="meta-caps">Voice</legend>
        <div class="listen-voices" id="listen-voices" role="group" aria-label="Choose a reading voice"></div>
      </fieldset>

      <fieldset class="listen-fieldset">
        <legend class="meta-caps">Speed</legend>
        <div class="listen-rates" id="listen-rates" role="group" aria-label="Choose a reading speed"></div>
      </fieldset>
    </div>

    <div class="listen-transport">
      <button type="button" class="listen-btn listen-btn--prev" id="listen-prev" aria-label="Previous section">
        &larr;
      </button>
      <button type="button" class="listen-btn listen-btn--play" id="listen-play" aria-pressed="false">
        <span id="listen-play-label">Play</span>
      </button>
      <button type="button" class="listen-btn listen-btn--next" id="listen-next" aria-label="Next section">
        &rarr;
      </button>
      <button type="button" class="listen-btn listen-btn--stop" id="listen-stop" aria-label="Stop reading">
        Stop
      </button>
      <div class="listen-progress-track" aria-hidden="true">
        <div class="listen-progress-bar" id="listen-progress"></div>
      </div>
    </div>

    <p class="listen-status" id="listen-status" role="status" aria-live="polite"></p>
    <p class="listen-note" id="listen-translate-note"></p>
    <button type="button" class="listen-original" id="listen-original" hidden>
      Read &amp; listen in English instead
    </button>
  </div>

  <p class="listen-unavailable" id="listen-unsupported" hidden>
    This browser does not support on-device speech. The teaching is fully readable below — or open
    <a href="/listen/">the Listening Room</a> to see which browsers can read aloud.
  </p>
</section>

<script>
  import { initListenRoom } from '../scripts/listen-room';
  initListenRoom();
</script>
