---
import { getCategoryByName } from '../data/categories';

interface Props {
  category: string;
  linked?: boolean;
}

const { category, linked = true } = Astro.props;
const cat = getCategoryByName(category);
---

{
  linked ? (
    <a class="category-chip" href={`/category/${cat.slug}/`}>
      {cat.name}
    </a>
  ) : (
    <span class="category-chip">{cat.name}</span>
  )
}
