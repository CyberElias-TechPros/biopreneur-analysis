---
import { SITE } from '../data/site';
---

<aside class="author-box" aria-label="About the Teacher">
  <picture class="author-avatar">
    <source type="image/webp" srcset="/images/author-ellis-graham-160.webp" />
    <img
      src="/images/author-ellis-graham-160.jpg"
      srcset="/images/author-ellis-graham-160.jpg 160w, /images/author-ellis-graham-400.jpg 400w"
      sizes="72px"
      alt={SITE.teacher.imageAlt}
      width="72"
      height="72"
      loading="lazy"
      decoding="async"
    />
  </picture>
  <div>
    <p class="meta-caps" style="margin: 0 0 0.25rem 0;">
      {SITE.teacher.role}
    </p>
    <p
      style="font-family: var(--font-display); font-size: 1.25rem; margin: 0 0 0.55rem 0; color: var(--ink);"
    >
      <a href="/about/" style="color: inherit;">{SITE.teacher.name}</a>
    </p>
    <p style="margin: 0 0 0.75rem 0; font-size: 0.95rem; color: var(--ink-soft);">
      {SITE.teacher.shortBio}
    </p>
    <p class="meta-caps" style="margin: 0;">
      <a href="/doctrinal-basis/">Read our Doctrinal Basis &rarr;</a>
    </p>
  </div>
</aside>
