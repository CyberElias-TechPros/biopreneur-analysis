---
import BaseLayout from '../layouts/BaseLayout.astro';
import LightLine from '../components/LightLine.astro';
import CommunityInvite from '../components/CommunityInvite.astro';
import { SITE } from '../data/site';

const contactOrigin = (Astro.site || new URL(SITE.url)).toString().replace(/\/$/, '');
const contactUrl = `${contactOrigin}/contact/`;
const contactSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': `${contactUrl}#contact`,
    name: `Contact ${SITE.name}`,
    description: `Editorial and teaching correspondence for ${SITE.name}.`,
    url: contactUrl,
    inLanguage: SITE.language,
    isPartOf: { '@id': `${contactOrigin}/#website` },
    mainEntity: {
      '@type': 'Organization',
      '@id': `${contactOrigin}/#organization`,
      name: SITE.name,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'editorial',
        telephone: SITE.whatsapp.tel,
        url: `${contactOrigin}/contact/`,
        availableLanguage: ['en'],
        contactOption: 'TollFree',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${contactOrigin}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: contactUrl },
    ],
  },
];
---

<BaseLayout
  title={`Contact ${SITE.name} — Questions, Corrections & Prayer`}
  description="Send Scripture questions, feedback, corrections, or correspondence to the Live In Jesus Name teaching desk by WhatsApp. No account or email needed."
  canonicalPath="/contact/"
  jsonLd={contactSchema}
>
  <section class="page-header">
    <div class="swiss-container">
      <p class="meta-caps" style="color: var(--gold-text); margin: 0 0 0.45rem 0;">
        Correspondence
      </p>
      <h1>Contact the Teaching Desk</h1>
      <p style="max-width: 58ch; font-size: 1.1rem; color: var(--ink-soft);">
        Whether you have a thoughtful question about a Scripture passage, want to flag a typographical error,
        or wish to share how a teaching helped clarify your walk with Christ, we welcome your note.
        Correspondence runs over WhatsApp, so there is no form to leave and no email account to open.
      </p>
    </div>
  </section>

  <LightLine />

  <section class="swiss-container" style="padding-block: 3.25rem;">
    <div class="swiss-grid">
      <!-- Left 4 columns: Direct details & expectations -->
      <div style="grid-column: span 4;">
        <h2 style="margin-top: 0; font-size: 1.45rem;">Direct Teaching Desk</h2>
        <p style="color: var(--ink-soft);">
          The desk line is a WhatsApp number. Message it any time, from any device with WhatsApp installed.
          No website account is needed, and this site never asks you for an email address.
        </p>
        <p style="font-family: var(--font-display); font-size: 1.2rem; margin-bottom: 1.75rem;">
          <a
            href={`https://wa.me/${SITE.whatsapp.e164}`}
            target="_blank"
            rel="noopener"
          >{SITE.whatsapp.display}</a>
          <span style="display: block; font-family: var(--font-body); font-size: 0.82rem; color: var(--ink-soft); margin-top: 0.35rem;">
            Opens WhatsApp &middot; international format, replies in West Africa Time (WAT)
          </span>
        </p>

        <h3 style="font-size: 1.15rem;">Response Window</h3>
        <p style="color: var(--ink-soft); font-size: 0.95rem;">
          Every message is read by a human editor. We aim to respond to editorial and doctrinal inquiries within
          <strong> 2–4 business days</strong>.
        </p>

        <h3 style="font-size: 1.15rem;">Pastoral &amp; Urgent Care Note</h3>
        <p style="color: var(--ink-soft); font-size: 0.95rem;">
          While we pray faithfully over reader notes, an online publication cannot substitute for local church shepherds,
          licensed counsellors, or emergency medical professionals. In urgent health or safety situations, please contact
          qualified local care immediately.
        </p>
      </div>

      <!-- Right 8 columns: Accessible Contact Form -->
      <div style="grid-column: span 8;">
        <h2 style="margin-top: 0; font-size: 1.45rem;">Compose on WhatsApp</h2>
        <p style="color: var(--ink-soft); margin-bottom: 1.5rem;">
          Fill this in and the button opens WhatsApp with your message already written, addressed to the desk.
          Nothing is submitted to this website — the text goes straight into your own WhatsApp.
        </p>

        <form
          id="contact-form"
          style="padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--surface); border: 1px solid var(--border-subtle);"
        >
          <div class="form-field">
            <label for="contact-name">Your Name *</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="form-input"
              placeholder="e.g. Grace Mensah"
            />
          </div>

          <div class="form-field">
            <label for="contact-phone">Your WhatsApp Number <span style="font-weight: 400; color: var(--ink-soft);">(optional)</span></label>
            <input
              id="contact-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              class="form-input"
              placeholder="+234 700 000 0000 — so we can reply if the chat does not go through"
            />
          </div>

          <div class="form-field">
            <label for="contact-topic">Subject *</label>
            <select id="contact-topic" name="topic" class="form-select" required>
              <option value="Scripture or Teaching Question">Scripture or Teaching Question</option>
              <option value="Testimony / Encouragement">Testimony / Reader Encouragement</option>
              <option value="Editorial or Scripture Citation Correction">
                Editorial or Scripture Citation Correction
              </option>
              <option value="Privacy or Policy Inquiry">Privacy or Policy Inquiry</option>
              <option value="General Correspondence">General Correspondence</option>
            </select>
          </div>

          <div class="form-field">
            <label for="contact-message">Your Message *</label>
            <textarea
              id="contact-message"
              name="message"
              required
              minlength="10"
              class="form-textarea"
              placeholder="Write your question, reference, or note..."
            ></textarea>
          </div>

          <p style="font-size: 0.85rem; color: var(--ink-soft); margin-bottom: 1.25rem;">
            This form does not send anything to our servers. It only prepares a WhatsApp message on your device.
            We use the details you write solely to read and reply to your inquiry, in accordance with our
            <a href="/privacy/">Privacy Policy</a>. We never sell or rent reader details.
          </p>

          <button
            type="submit"
            class="btn-editorial"
            style="cursor: pointer;"
          >
            Open in WhatsApp &rarr;
          </button>

          <div
            id="contact-status"
            role="status"
            aria-live="polite"
            hidden
            style="margin-top: 1.25rem; padding: 1rem 1.2rem; border-left: 3px solid var(--gold); background: var(--surface-subtle);"
          ></div>
        </form>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ deskNumber: SITE.whatsapp.e164, deskDisplay: SITE.whatsapp.display }}>
    (function () {
      var form = document.getElementById('contact-form');
      var status = document.getElementById('contact-status');
      if (!form || !status) return;

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var name = document.getElementById('contact-name').value.trim();
        var phone = document.getElementById('contact-phone').value.trim();
        var topic = document.getElementById('contact-topic').value;
        var message = document.getElementById('contact-message').value.trim();

        var lines = ['*' + topic + '*', '', message, '', '— ' + name];
        if (phone) lines.push('Reply to: ' + phone);

        var waHref = 'https://wa.me/' + deskNumber + '?text=' + encodeURIComponent(lines.join('\n'));

        status.hidden = false;
        status.innerHTML =
          '<strong>Opening WhatsApp.</strong> Your message is addressed to <code>' +
          deskDisplay +
          '</code>. If nothing happens, <a href="' +
          waHref +
          '" target="_blank" rel="noopener">tap here to open the chat</a>, or message that number from your own WhatsApp.';

        window.open(waHref, '_blank', 'noopener');
      });
    })();
  </script>

  <LightLine />

  <section class="swiss-container" style="padding-block: clamp(2.5rem, 5vw, 3.5rem);">
    <h2 style="margin-top: 0;">Or Join the Conversation</h2>
    <p style="color: var(--ink-soft); max-width: 62ch;">
      Many questions are better answered in a room than in a private message. These are the two reader
      channels — a broadcast for the daily teaching, and a group for discussion and prayer.
    </p>
    <div style="max-width: 720px;">
      <CommunityInvite variant="panel" />
    </div>
  </section>
</BaseLayout>

<style>
  @media (max-width: 820px) {
    .swiss-grid > div {
      grid-column: 1 / -1 !important;
    }
  }
</style>
