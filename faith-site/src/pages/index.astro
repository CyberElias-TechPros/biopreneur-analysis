---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CommunityInvite from '../components/CommunityInvite.astro';
import AuthorBox from '../components/AuthorBox.astro';
import HeroTitle from '../components/showcase/HeroTitle.astro';
import HeroIsland from '../components/showcase/HeroIsland';
import GildedLabel from '../components/showcase/GildedLabel';
import StatsRow from '../components/showcase/StatsRow';
import CtaIsland from '../components/showcase/CtaIsland';
import Marquee from '../components/showcase/Marquee';
import PillarGrid from '../components/showcase/PillarGrid';
import SplitText from '../components/reactbits/SplitText';
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';
import { getYearSlate } from '../data/slate';

const allArticles = (await getCollection('articles')).sort(
  (a, b) => a.data.day - b.data.day
);
const dayOne = allArticles[0];
const slate = getYearSlate();
const latestArticles = [...allArticles]
  .sort((a, b) => b.data.day - a.data.day)
  .slice(0, 8);

const countsByCategory: Record<string, number> = {};
for (const entry of allArticles) {
  countsByCategory[entry.data.category] =
    (countsByCategory[entry.data.category] || 0) + 1;
}

const pillars = CATEGORIES.filter((c) => c.featuredOnHome).map((c) => ({
  numeral: c.numeral,
  name: c.name,
  slug: c.slug,
  shortLine: c.shortLine,
  anchors: c.anchors,
  count: countsByCategory[c.name] || 0,
}));

const recentArticles = [...allArticles].slice(-10).reverse();
const homeOrigin = (Astro.site || new URL(SITE.url)).toString().replace(/\/$/, '');
const homeUrl = `${homeOrigin}/`;
const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${homeUrl}#blog`,
    name: SITE.name,
    description: SITE.mission,
    url: homeUrl,
    inLanguage: SITE.language,
    publisher: { '@id': `${homeOrigin}/#organization` },
    isPartOf: { '@id': `${homeOrigin}/#website` },
    about: { '@id': `${homeOrigin}/#subject` },
    audience: {
      '@type': 'Audience',
      audienceType: 'Christians seeking Scripture-anchored teaching',
      geographicArea: SITE.targetRegions.map((r) => ({ '@type': 'Country', identifier: r })),
    },
    blogPost: recentArticles.map((entry) => {
      const prose = (entry.body || '')
        .split('<!-- AUDIT-BELOW -->')[0]
        .split('<!-- END-PROSE -->')[0];
      const words = prose
        .replace(/[*_>#`|-]/g, ' ')
        .split(/\s+/)
        .filter((w) => /[A-Za-z0-9]/.test(w)).length + 180;
      const postUrl = `${homeOrigin}/${entry.data.slug}/`;
      return {
        '@type': 'BlogPosting',
        '@id': `${postUrl}#article`,
        headline: entry.data.title,
        description: entry.data.description,
        url: postUrl,
        mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
        datePublished: entry.data.pubDate,
        dateModified: entry.data.updatedDate || entry.data.pubDate,
        inLanguage: SITE.language,
        wordCount: words,
        articleSection: entry.data.category,
        keywords: [entry.data.primaryKeyword, ...entry.data.secondaryKeywords].join(', '),
        image: {
          '@type': 'ImageObject',
          url: `${homeOrigin}/images/open-scripture.jpg`,
          width: 1200,
          height: 654,
          caption: entry.data.featuredImageAlt,
        },
        author: { '@id': `${homeOrigin}/about/#ellis-graham` },
        publisher: { '@id': `${homeOrigin}/#organization` },
        isPartOf: { '@id': `${homeOrigin}/#website` },
      };
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': `${homeUrl}#courses`,
    name: 'Twelve-month doctrinal curriculum',
    numberOfItems: slate.length,
    itemListElement: slate.map((month, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `Month ${String(month.monthNumber).padStart(2, '0')}: ${month.monthName}`,
      description: month.subtitle,
    })),
  },
];
---

<BaseLayout
  title={`${SITE.name} — Scripture-Anchored Christian Teaching`}
  description="Live In Jesus Name publishes Scripture-saturated teaching on your new-creation identity in Christ, right standing by grace, and wise daily living."
  canonicalPath="/"
  preloadHero={true}
  experience={true}
  jsonLd={homeSchema}
>
  <div class="showcase">
    <!-- ============================================================ HERO -->
    <section class="sc-hero" data-hero>
      <div class="sc-hero__media" data-hero-media aria-hidden="true">
        <picture>
          <source
            type="image/avif"
            srcset="/images/hero-dawn-960.avif 960w, /images/hero-dawn-1600.avif 1600w"
            sizes="100vw"
          />
          <source
            type="image/webp"
            srcset="/images/hero-dawn-960.webp 960w, /images/hero-dawn-1600.webp 1600w"
            sizes="100vw"
          />
          <img
            src="/images/hero-dawn-1600.webp"
            alt="First dawn light rising over a quiet misted horizon"
            width="1600"
            height="893"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>

      <div class="sc-hero__fallback" aria-hidden="true"></div>
      <HeroIsland client:load />
      <div class="sc-hero__veil" aria-hidden="true"></div>
      <div class="sc-hero__grain" aria-hidden="true"></div>

      <!-- Celestial orbit: the dawn-arc-and-cross motif as an instrument -->
      <div class="sc-orbit" data-hero-orbit aria-hidden="true">
        <div class="sc-orbit__ring"></div>
        <div class="sc-orbit__ring sc-orbit__ring--2"></div>
        <div class="sc-orbit__ring sc-orbit__ring--3"></div>
        <div class="sc-orbit__spin"></div>
        <svg class="sc-orbit__arc" viewBox="0 0 100 100" fill="none">
          <line x1="14" y1="66" x2="86" y2="66" stroke="#d4af6a" stroke-width="0.8" opacity="0.7" />
          <path d="M30 66 A20 20 0 0 1 70 66" stroke="#d4af6a" stroke-width="0.9" />
          <line x1="50" y1="20" x2="50" y2="80" stroke="#d4af6a" stroke-width="1" stroke-linecap="round" />
          <line x1="38" y1="36" x2="62" y2="36" stroke="#d4af6a" stroke-width="0.9" stroke-linecap="round" />
        </svg>
      </div>

      <div class="swiss-container sc-hero__content" data-hero-recede>
        <span class="sc-hero__line" data-hero-line aria-hidden="true"></span>
        <span class="sc-kicker" data-hero-kicker>
          <GildedLabel client:visible text="Revelation · Identity · Everyday Walk in Christ" />
        </span>

        <HeroTitle
          lines={['The entrance of', 'His Word gives', 'light.']}
          accentLine={2}
        />

        <p class="sc-hero__lead" data-hero-fade>{SITE.mission}</p>

        <div class="sc-hero__actions" data-hero-fade>
          {dayOne && (
            <CtaIsland client:load href={`/${dayOne.data.slug}/`} label="Begin at Day 001 →" cursorVerb="Read" />
          )}
          <a class="sc-btn-ghost" href="/teachings/" data-magnet="0.18" data-cursor="Browse">
            Browse the Library
          </a>
        </div>

        <StatsRow client:load />
      </div>

      <div class="sc-scroll-cue" aria-hidden="true">
        <span class="sc-scroll-cue__label">Scroll</span>
        <span class="sc-scroll-cue__line"></span>
      </div>
    </section>

    <!-- ======================================================= MARQUEE -->
    <Marquee client:visible />

    <!-- ====================================================== MANIFESTO -->
    <section class="sc-manifesto swiss-container">
      <div class="sc-manifesto__grid">
        <div class="sc-manifesto__sticky" data-rise>
          <span class="sc-kicker">The Reading Room</span>
          <SplitText
            client:visible
            tag="h2"
            text="Information is not yet understanding."
            effect="rise"
            splitType="words"
            delay={34}
            duration={0.8}
            threshold={0.2}
            className="sc-manifesto__title"
          />
        </div>
        <div class="sc-manifesto__body" data-rise>
          <p>
            Many sincere believers know what a verse says on the page while still living beneath what it means.
            <strong> {SITE.name}</strong> exists as a quiet, unhurried teaching room built around one discipline:
            examining Scripture in context until truth moves from memory into spiritual understanding, settled
            consciousness, and responsible weekday conduct.
          </p>
          <p>
            No popups, no sensational claims, and no borrowed slogans — every study opens the biblical text,
            traces cross-references across both Testaments, pairs faith with practical wisdom, and closes with a
            Scripture-anchored confession you can speak aloud.
          </p>
        </div>
      </div>
    </section>

    <hr class="sc-rule" />

    <!-- ======================================================== PILLARS -->
    <section class="sc-pillars swiss-container">
      <div class="sc-section-head" data-rise>
        <div>
          <span class="sc-kicker">Core Pillars</span>
          <h2>Four Doctrinal Foundations</h2>
        </div>
        <a class="sc-link" href="/teachings/#categories" data-cursor="View">View all 12 categories →</a>
      </div>
      <PillarGrid client:visible pillars={pillars} />
    </section>

    <!-- ============================================== PINNED ARC RAIL -->
    <section class="sc-rail-section">
      <div class="sc-rail__head swiss-container" data-rise>
        <div class="sc-section-head">
          <div>
            <span class="sc-kicker">The Full-Year Architecture</span>
            <h2>Twelve Monthly Arcs · 365 Studies</h2>
            <p class="meta-caps" style="margin: 0.4rem 0 0 0; color: var(--ink-soft);">Plus search-led teachings answering the questions readers actually type</p>
          </div>
          <a class="sc-link" href="/slate/" data-cursor="Browse">Browse all 365 topics →</a>
        </div>
      </div>

      <div class="sc-rail" data-arc-rail>
        <div class="sc-rail__track" data-arc-track>
          {slate.map((m) => (
            <a class="sc-month" href={`/slate/#month-${m.monthNumber}`} data-cursor="Open">
              <span class="sc-month__num">{String(m.monthNumber).padStart(2, '0')}</span>
              <span class="sc-month__name">{m.monthName}</span>
              <span class="sc-month__title">{m.arcTitle}</span>
              <span class="sc-month__anchors">{m.anchors}</span>
              <span class="sc-month__days">{m.totalDays} days · Month {String(m.monthNumber).padStart(2, '0')}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="swiss-container">
        <div class="sc-rail__hint" data-rise>
          <span class="sc-rail__hint-line"></span>
          Scroll to travel the year
        </div>
      </div>
    </section>

    <!-- ================================================== LATEST INDEX -->
    <section class="sc-index swiss-container">
      <div class="sc-section-head" data-rise>
        <div>
          <span class="sc-kicker">Latest · {allArticles.length} Teachings Live</span>
          <h2>Newest Teachings</h2>
        </div>
        <a class="sc-link" href="/teachings/" data-cursor="Browse">Open full Teaching Index →</a>
      </div>

      <ol class="sc-index__list" data-rise-group>
        {latestArticles.map((entry) => (
          <li class="sc-row">
            <span class="sc-row__day">Day {String(entry.data.day).padStart(3, '0')}</span>
            <div>
              <a class="sc-row__title" href={`/${entry.data.slug}/`} data-cursor="Read">{entry.data.title}</a>
              <p class="sc-row__sub">{entry.data.centralTruth}</p>
              <p class="sc-row__meta">
                {entry.data.themeScripture.reference} ({entry.data.themeScripture.translation})
              </p>
            </div>
            <span class="sc-row__arrow" aria-hidden="true">→</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- ================================================ LISTENING ROOM -->
    <section class="sc-listen">
      <div class="swiss-container sc-listen__inner">
        <div class="sc-listen__copy" data-rise>
          <span class="sc-kicker">The Listening Room</span>
          <h2>Hear It While You Drive, Cook, or Lie Awake</h2>
          <p>
            Every teaching can be listened to instead of read — in four voices, six speeds, and thirteen
            languages. The speech is generated on your own device, so it is private, free, and works without a
            connection once the page has loaded.
          </p>
          <a class="sc-btn-ghost" href="/listen/" data-magnet="0.18" data-cursor="Listen">Enter the Listening Room →</a>
        </div>
        <div class="sc-listen__art" data-rise>
          <div class="sc-wave" data-rise-group aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span>
          </div>
          <p class="sc-listen__caption">Browser narration · No download · Never autoplays</p>
        </div>
      </div>
    </section>

    <!-- ===================================================== COMMUNITY -->
    <section class="sc-community swiss-container">
      <div class="sc-community__inner">
        <div data-rise>
          <span class="sc-kicker">Beyond the Page</span>
          <h2>Read Alone, or Read Together</h2>
          <p>
            These teachings are written to be read in a quiet room. They are also written to be argued with,
            prayed over, and lived out among people. If you want company for that work, there are two rooms
            waiting — one where the day's teaching arrives, and one where readers talk it through.
          </p>
          <a class="sc-link" href="/community/" data-cursor="Join">How the community rooms work →</a>
        </div>
        <div data-rise>
          <CommunityInvite variant="panel" compact={true} heading="Join in one tap" />
        </div>
      </div>
    </section>

    <!-- ======================================================== AUTHOR -->
    <section class="sc-author swiss-container" data-rise>
      <AuthorBox />
    </section>
  </div>
</BaseLayout>

<style>
  .sc-hero__line {
    display: block;
    width: 84px;
    height: 1px;
    margin-bottom: 1.6rem;
    background: linear-gradient(90deg, var(--sc-gold), transparent);
  }
  .sc-manifesto__title {
    max-width: 12ch;
  }
  .sc-community .sc-link {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sc-gold);
  }
</style>
