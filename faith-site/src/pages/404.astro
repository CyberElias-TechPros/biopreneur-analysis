---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title={`Page Not Found — ${SITE.name}`}
  description="That page is not in the library. Return to the Live In Jesus Name teaching library, browse the 365-day curriculum slate, or search all published studies."
  noindex={true}
>
  <section class="reading-container" style="padding-block: 5rem; text-align: center;">
    <p class="meta-caps" style="color: var(--gold-text); margin-bottom: 0.75rem;">
      404 &middot; Page Not Found
    </p>
    <h1>That path is not in the library.</h1>
    <p style="color: var(--ink-soft); max-width: 48ch; margin-inline: auto; margin-bottom: 2rem;">
      The link may have moved or the teaching you are looking for may be scheduled further ahead on our 365-day curriculum slate.
    </p>
    <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      <a class="category-chip" href="/teachings/" style="padding: 0.7rem 1.2rem;">
        Browse Published Teachings &rarr;
      </a>
      <a class="category-chip" href="/slate/" style="padding: 0.7rem 1.2rem;">
        View 365-Day Slate
      </a>
    </div>
  </section>
</BaseLayout>
