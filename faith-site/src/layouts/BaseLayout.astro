---
import '../styles/global.css';
import '../styles/showcase.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import SiteSearch from '../components/SiteSearch.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  preloadHero?: boolean;
  showReadingProgress?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  articleSection?: string;
  articleTags?: string[];
  /**
   * The cinematic experience layer (Lenis smooth scroll + GSAP ScrollTrigger
   * reveals, pins and parallax). On for marketing surfaces, OFF for article
   * prose so long-form reading keeps native, predictable scrolling.
   */
  experience?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  preloadHero = false,
  showReadingProgress = false,
  jsonLd,
  noindex = false,
  articleSection,
  articleTags,
  experience = false,
} = Astro.props;

const siteUrl = (Astro.site || new URL(SITE.url)).toString().replace(/\/$/, '');
/**
 * Site-wide identity graph.
 *
 * Emitted as ONE `@graph` document per page rather than a stack of unrelated
 * `<script>` blocks. That distinction matters to AI systems and search engines:
 * a graph lets a parser resolve `{ "@id": ... }` references and understand that
 * the article, the person, the website, and the publisher are different nodes of
 * the same entity, instead of four things that happen to share a page.
 *
 * Node inventory:
 *   Organization · WebSite · Person (author) · Subject/Thing for the topic of
 *   the publication · CollectionPage for the library (referenced, not repeated).
 */
const personId = `${siteUrl}/about/#ellis-graham`;
const orgId = `${siteUrl}/#organization`;
const siteId = `${siteUrl}/#website`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'OnlineBusiness'],
  '@id': orgId,
  name: SITE.name,
  alternateName: SITE.shortName,
  url: `${siteUrl}/`,
  description: SITE.description,
  slogan: SITE.tagline,
  foundingDate: String(SITE.foundedYear),
  knowsLanguage: ['en'],
  logo: {
    '@type': 'ImageObject',
    '@id': `${siteUrl}/#logo`,
    url: `${siteUrl}/icons/icon-512.png`,
    contentUrl: `${siteUrl}/icons/icon-512.png`,
    width: 512,
    height: 512,
    caption: SITE.name,
  },
  image: { '@id': `${siteUrl}/images/og-default.png#primaryimage` },
  founder: { '@id': personId },
  employee: { '@id': personId },
  knowsAbout: SITE.topics,
  publishingPrinciples: `${siteUrl}/doctrinal-basis/`,
  diversityPolicy: `${siteUrl}/about/`,
  ethicsPolicy: `${siteUrl}/doctrinal-basis/`,
  ownershipFundingInfo: `${siteUrl}/about/`,
  actionableFeedbackPolicy: `${siteUrl}/contact/`,
  correctionsPolicy: `${siteUrl}/contact/`,
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'editorial',
      telephone: SITE.whatsapp.tel,
      url: `${siteUrl}/contact/`,
      contactOption: 'TollFree',
      availableLanguage: ['en'],
    },
  ],
  sameAs: [SITE.community.channel.href, SITE.community.group.href],
};

const defaultWebSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': siteId,
  name: SITE.name,
  alternateName: SITE.shortName,
  url: `${siteUrl}/`,
  description: SITE.description,
  inLanguage: SITE.language,
  publisher: { '@id': orgId },
  license: `${siteUrl}/about/`,
  copyrightHolder: { '@id': orgId },
  potentialAction: [
    {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}/teachings/?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
    {
      // The Listening Room is a first-class way into the corpus, so the site
      // advertises it as an action rather than only as a link.
      '@type': 'ListenAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/listen/` },
      name: 'Hear any teaching read aloud',
    },
  ],
};

const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId,
  name: SITE.teacher.name,
  jobTitle: SITE.teacher.role,
  description: SITE.teacher.shortBio,
  url: `${siteUrl}/about/`,
  worksFor: { '@id': orgId },
  knowsAbout: SITE.topics,
  image: {
    '@type': 'ImageObject',
    url: `${siteUrl}${SITE.teacher.image}`,
    width: SITE.teacher.imageWidth,
    height: SITE.teacher.imageHeight,
    caption: SITE.teacher.imageAlt,
  },
};

// What the publication is *about*, as an entity. This is the node answer engines
// reach for when asked "what is Live In Jesus Name about?".
const subjectSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': `${siteUrl}/#subject`,
  name: `${SITE.name} — teaching subjects`,
  description:
    'The doctrinal and practical subjects covered by the teaching library, from new-creation identity to divine healing and stewardship.',
  url: `${siteUrl}/glossary/`,
  inLanguage: SITE.language,
  publisher: { '@id': orgId },
  hasDefinedTerm: SITE.topics.slice(0, 12).map((topic) => ({
    '@type': 'DefinedTerm',
    name: topic,
    inDefinedTermSet: { '@id': `${siteUrl}/#subject` },
  })),
};

// One @graph per page: page-specific nodes (minus their own @context) followed by
// the shared identity nodes. `@graph` with a single @context is the form Google
// documents and the form that lets a consumer link nodes by @id.
const pageNodes = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((node) => {
      const { '@context': _ctx, ...rest } = node as Record<string, unknown>;
      return rest;
    })
  : [];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    ...pageNodes,
    organizationSchema,
    defaultWebSiteSchema,
    authorSchema,
    subjectSchema,
  ].map((node) => {
    const { '@context': _ctx, ...rest } = node as Record<string, unknown>;
    return rest;
  }),
};
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <BaseHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      preloadHero={preloadHero}
      noindex={noindex}
      articleSection={articleSection}
      articleTags={articleTags}
    />
    <JsonLd data={pageSchema} />
  </head>
  <body data-experience={experience ? 'true' : undefined}>
    <a class="skip-link" href="#main-content">Skip to teaching content</a>

    {/* Page-transition curtain — a fast gilded wipe between full page loads.
        Purely decorative (aria-hidden, pointer-events:none); links work normally
        if JS is off or reduced-motion is set. */}
    <div class="page-curtain" data-page-curtain aria-hidden="true">
      <div class="page-curtain__panel"></div>
      <div class="page-curtain__mark">
        <svg width="40" height="40" viewBox="0 0 36 36" fill="none" focusable="false">
          <line x1="4" y1="23" x2="32" y2="23" stroke="currentColor" stroke-width="1.4" opacity="0.6" />
          <path d="M9 23 A9 9 0 0 1 27 23" stroke="currentColor" stroke-width="1.4" fill="none" />
          <line x1="18" y1="6" x2="18" y2="29" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <line x1="13" y1="12" x2="23" y2="12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
        <span>{SITE.name}</span>
      </div>
    </div>

    {experience && <div class="cursor-glow" data-cursor-glow aria-hidden="true"></div>}
    {experience && (
      <div class="cursor-ring" data-cursor-ring aria-hidden="true">
        <span class="cursor-ring__label" data-cursor-label></span>
      </div>
    )}
    {experience && <div class="cursor-dot" data-cursor-dot aria-hidden="true"></div>}
    <Header />
    <SiteSearch />
    {showReadingProgress && <ReadingProgress />}
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <script is:inline src="/sw-register.js" defer></script>

    <script>
      import { initChrome } from '../scripts/chrome';
      import { initConsent } from '../scripts/consent';
      initChrome();
      initConsent();

      document.querySelectorAll('[data-open-consent]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          // Re-opens the same sheet the reader saw on first visit.
          var api = window.ijnConsent;
          if (api) api.open();
        });
      });
    </script>

    {experience && (
      <script>
        import '../scripts/experience';
      </script>
    )}
  </body>
</html>
