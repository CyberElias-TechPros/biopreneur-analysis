---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  preloadHero?: boolean;
  showReadingProgress?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  articleSection?: string;
  articleTags?: string[];
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  preloadHero = false,
  showReadingProgress = false,
  jsonLd,
  noindex = false,
  articleSection,
  articleTags,
} = Astro.props;

const siteUrl = (Astro.site || new URL(SITE.url)).toString().replace(/\/$/, '');
/**
 * Site-wide identity graph.
 *
 * Emitted as ONE `@graph` document per page rather than a stack of unrelated
 * `<script>` blocks. That distinction matters to AI systems and search engines:
 * a graph lets a parser resolve `{ "@id": ... }` references and understand that
 * the article, the person, the website, and the publisher are different nodes of
 * the same entity, instead of four things that happen to share a page.
 *
 * Node inventory:
 *   Organization · WebSite · Person (author) · Subject/Thing for the topic of
 *   the publication · CollectionPage for the library (referenced, not repeated).
 */
const personId = `${siteUrl}/about/#ellis-graham`;
const orgId = `${siteUrl}/#organization`;
const siteId = `${siteUrl}/#website`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'OnlineBusiness'],
  '@id': orgId,
  name: SITE.name,
  alternateName: SITE.shortName,
  url: `${siteUrl}/`,
  description: SITE.description,
  slogan: SITE.tagline,
  foundingDate: String(SITE.foundedYear),
  knowsLanguage: ['en'],
  logo: {
    '@type': 'ImageObject',
    '@id': `${siteUrl}/#logo`,
    url: `${siteUrl}/icons/icon-512.png`,
    contentUrl: `${siteUrl}/icons/icon-512.png`,
    width: 512,
    height: 512,
    caption: SITE.name,
  },
  image: { '@id': `${siteUrl}/images/og-default.png#primaryimage` },
  founder: { '@id': personId },
  employee: { '@id': personId },
  knowsAbout: SITE.topics,
  publishingPrinciples: `${siteUrl}/doctrinal-basis/`,
  diversityPolicy: `${siteUrl}/about/`,
  ethicsPolicy: `${siteUrl}/doctrinal-basis/`,
  ownershipFundingInfo: `${siteUrl}/about/`,
  actionableFeedbackPolicy: `${siteUrl}/contact/`,
  correctionsPolicy: `${siteUrl}/contact/`,
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'editorial',
      telephone: SITE.whatsapp.tel,
      url: `${siteUrl}/contact/`,
      contactOption: 'TollFree',
      availableLanguage: ['en'],
    },
  ],
  sameAs: [SITE.community.channel.href, SITE.community.group.href],
};

const defaultWebSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': siteId,
  name: SITE.name,
  alternateName: SITE.shortName,
  url: `${siteUrl}/`,
  description: SITE.description,
  inLanguage: SITE.language,
  publisher: { '@id': orgId },
  license: `${siteUrl}/about/`,
  copyrightHolder: { '@id': orgId },
  potentialAction: [
    {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}/teachings/?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
    {
      // The Listening Room is a first-class way into the corpus, so the site
      // advertises it as an action rather than only as a link.
      '@type': 'ListenAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/listen/` },
      name: 'Hear any teaching read aloud',
    },
  ],
};

const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId,
  name: SITE.teacher.name,
  jobTitle: SITE.teacher.role,
  description: SITE.teacher.shortBio,
  url: `${siteUrl}/about/`,
  worksFor: { '@id': orgId },
  knowsAbout: SITE.topics,
  image: {
    '@type': 'ImageObject',
    url: `${siteUrl}${SITE.teacher.image}`,
    width: SITE.teacher.imageWidth,
    height: SITE.teacher.imageHeight,
    caption: SITE.teacher.imageAlt,
  },
};

// What the publication is *about*, as an entity. This is the node answer engines
// reach for when asked "what is Live In Jesus Name about?".
const subjectSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': `${siteUrl}/#subject`,
  name: `${SITE.name} — teaching subjects`,
  description:
    'The doctrinal and practical subjects covered by the teaching library, from new-creation identity to divine healing and stewardship.',
  url: `${siteUrl}/glossary/`,
  inLanguage: SITE.language,
  publisher: { '@id': orgId },
  hasDefinedTerm: SITE.topics.slice(0, 12).map((topic) => ({
    '@type': 'DefinedTerm',
    name: topic,
    inDefinedTermSet: { '@id': `${siteUrl}/#subject` },
  })),
};

// One @graph per page: page-specific nodes (minus their own @context) followed by
// the shared identity nodes. `@graph` with a single @context is the form Google
// documents and the form that lets a consumer link nodes by @id.
const pageNodes = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((node) => {
      const { '@context': _ctx, ...rest } = node as Record<string, unknown>;
      return rest;
    })
  : [];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    ...pageNodes,
    organizationSchema,
    defaultWebSiteSchema,
    authorSchema,
    subjectSchema,
  ].map((node) => {
    const { '@context': _ctx, ...rest } = node as Record<string, unknown>;
    return rest;
  }),
};
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <BaseHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      preloadHero={preloadHero}
      noindex={noindex}
      articleSection={articleSection}
      articleTags={articleTags}
    />
    <JsonLd data={pageSchema} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to teaching content</a>
    <Header />
    {showReadingProgress && <ReadingProgress />}
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <script is:inline src="/sw-register.js" defer></script>

    <script>
      import { initConsent } from '../scripts/consent';
      initConsent();

      document.querySelectorAll('[data-open-consent]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          // Re-opens the same sheet the reader saw on first visit.
          var api = window.ijnConsent;
          if (api) api.open();
        });
      });
    </script>

    <!-- Lightweight Progressive Enhancement (< 3.5 KB unminified) -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        var header = document.getElementById('site-header');
        var toggle = document.getElementById('theme-toggle');
        var icon = document.getElementById('theme-icon');
        var label = document.getElementById('theme-label');
        var menuBtn = document.getElementById('menu-toggle');
        var nav = document.getElementById('primary-nav');
        var progress = document.getElementById('reading-progress-bar');
        var waFloat = document.querySelector('[data-wa-float]');

        function syncThemeUI() {
          var current = html.getAttribute('data-theme') || 'light';
          if (icon) icon.textContent = current === 'dark' ? '☾' : '☀';
          if (label) label.textContent = current === 'dark' ? 'Night' : 'Light';
        }
        syncThemeUI();

        if (toggle) {
          toggle.addEventListener('click', function () {
            var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            try {
              localStorage.setItem('ijn-theme', next);
            } catch (e) {}
            syncThemeUI();
          });
        }

        if (menuBtn && nav) {
          menuBtn.addEventListener('click', function () {
            var open = nav.classList.toggle('is-open');
            menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        }

        function onScroll() {
          var y = window.scrollY || window.pageYOffset;
          if (header) {
            if (y > 24) header.classList.add('is-scrolled');
            else header.classList.remove('is-scrolled');
          }
          if (waFloat) {
            if (y > 420) waFloat.classList.add('is-scrolled');
            else waFloat.classList.remove('is-scrolled');
          }
          if (progress) {
            var docH = document.documentElement.scrollHeight - window.innerHeight;
            var pct = docH > 0 ? Math.min(100, Math.max(0, (y / docH) * 100)) : 0;
            progress.style.width = pct.toFixed(1) + '%';
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        // Reading text-size buttons (0.92x - 1.24x)
        var sizeBtns = document.querySelectorAll('[data-reading-scale]');
        var activeScale =
          html.style.getPropertyValue('--reading-scale') || '1';
        sizeBtns.forEach(function (btn) {
          var s = btn.getAttribute('data-reading-scale');
          btn.setAttribute('aria-pressed', s === activeScale ? 'true' : 'false');
          btn.addEventListener('click', function () {
            html.style.setProperty('--reading-scale', s);
            try {
              localStorage.setItem('ijn-scale', s);
            } catch (e) {}
            sizeBtns.forEach(function (b) {
              b.setAttribute(
                'aria-pressed',
                b.getAttribute('data-reading-scale') === s ? 'true' : 'false'
              );
            });
          });
        });

        // Scroll-reveal (once per element, DESIGN_SPEC §7)
        var reveals = document.querySelectorAll('[data-reveal]');
        if ('IntersectionObserver' in window && reveals.length) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
          );
          reveals.forEach(function (el) {
            io.observe(el);
          });
        } else {
          reveals.forEach(function (el) {
            el.classList.add('is-visible');
          });
        }

        // Declaration "Pace Aloud" affordance (progressive enhancement)
        var speakBtn = document.getElementById('speak-declaration-btn');
        var speakCard = document.getElementById('declaration-card');
        var speakText = document.getElementById('declaration-text');
        var speakLabel = document.getElementById('speak-btn-text');
        var paceTimer = null;

        if (speakBtn && speakCard && speakText) {
          speakBtn.addEventListener('click', function () {
            var active = speakBtn.getAttribute('aria-pressed') === 'true';
            if (active) {
              speakBtn.setAttribute('aria-pressed', 'false');
              speakCard.classList.remove('is-speaking');
              if (speakLabel) speakLabel.textContent = 'Pace Aloud';
              if (paceTimer) clearTimeout(paceTimer);
              if ('speechSynthesis' in window) window.speechSynthesis.cancel();
              return;
            }
            speakBtn.setAttribute('aria-pressed', 'true');
            speakCard.classList.add('is-speaking');
            if (speakLabel) speakLabel.textContent = 'Speaking...';
            var raw = (speakText.textContent || '').replace(/[“”"]/g, '').trim();
            if ('speechSynthesis' in window && 'SpeechSynthesisUtterance' in window) {
              try {
                window.speechSynthesis.cancel();
                var u = new SpeechSynthesisUtterance(raw);
                u.rate = 0.92;
                u.onend = u.onerror = function () {
                  speakBtn.setAttribute('aria-pressed', 'false');
                  speakCard.classList.remove('is-speaking');
                  if (speakLabel) speakLabel.textContent = 'Pace Aloud';
                };
                window.speechSynthesis.speak(u);
                return;
              } catch (e) {}
            }
            paceTimer = setTimeout(function () {
              speakBtn.setAttribute('aria-pressed', 'false');
              speakCard.classList.remove('is-speaking');
              if (speakLabel) speakLabel.textContent = 'Pace Aloud';
            }, 24000);
          });
        }

      })();
    </script>
  </body>
</html>
