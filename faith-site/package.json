{
  "name": "in-jesus-name",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "In Jesus Name — Reverent Editorial Christian revelation-teaching publication built with Astro",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "astro": "astro",
    "audit": "python3 scripts/audit_articles.py",
    "seo": "python3 scripts/seo_audit.py",
    "typecheck": "astro check",
    "test:listening": "node --experimental-strip-types --test scripts/test-listening.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^10.0.8",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@vercel/analytics": "^2.0.1",
    "astro": "^6.0.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.0.0"
  }
